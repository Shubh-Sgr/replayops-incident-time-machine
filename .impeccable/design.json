  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "High-intent incident action with rare warm emphasis.",
      "html": "<button class=\"ds-btn-primary\">Create incident</button>",
      "css": ".ds-btn-primary{min-height:44px;padding:0 16px;border:0;border-radius:10px;background:oklch(var(--accent));color:oklch(var(--accent-ink));font:600 14px 'IBM Plex Sans',sans-serif;transition:background-color 200ms}.ds-btn-primary:hover{background:oklch(var(--accent)/.9)}.ds-btn-primary:active{background:oklch(var(--accent)/.8)}.ds-btn-primary:focus-visible{outline:0;box-shadow:0 0 0 3px oklch(var(--focus)/.34)}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Neutral action that remains subordinate to the active incident control.",
      "html": "<button class=\"ds-btn-secondary\">Open workbench</button>",
      "css": ".ds-btn-secondary{min-height:44px;padding:0 16px;border:0;border-radius:10px;background:oklch(var(--elevated));color:oklch(var(--ink));font:600 14px 'IBM Plex Sans',sans-serif;transition:background-color 200ms}.ds-btn-secondary:hover{background:oklch(var(--line)/.55)}.ds-btn-secondary:focus-visible{outline:0;box-shadow:0 0 0 3px oklch(var(--focus)/.34)}"
    },
    {
      "name": "Quiet Button",
      "kind": "button",
      "description": "Low-emphasis utility action for close, navigation, and theme controls.",
      "html": "<button class=\"ds-btn-quiet\">Previous event</button>",
      "css": ".ds-btn-quiet{min-height:44px;padding:0 12px;border:0;border-radius:10px;background:transparent;color:oklch(var(--muted));font:600 14px 'IBM Plex Sans',sans-serif;transition:background-color 200ms,color 200ms}.ds-btn-quiet:hover{background:oklch(var(--elevated));color:oklch(var(--ink))}.ds-btn-quiet:focus-visible{outline:0;box-shadow:0 0 0 3px oklch(var(--focus)/.34)}"
    },
    {
      "name": "Instrument Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Rail-toned input with a calibrated boundary and brightened focus surface.",
      "html": "<input class=\"ds-field\" placeholder=\"Search incident evidence\" />",
      "css": ".ds-field{min-height:44px;width:100%;padding:0 14px;border:1px solid oklch(var(--line));border-radius:10px;background:oklch(var(--elevated));color:oklch(var(--ink));font:400 14px 'IBM Plex Sans',sans-serif;transition:background-color 200ms}.ds-field::placeholder{color:oklch(var(--faint))}.ds-field:hover{background:oklch(var(--line)/.3)}.ds-field:focus{background:oklch(var(--panel));outline:0;box-shadow:0 0 0 3px oklch(var(--focus)/.34)}"
    },
    {
      "name": "Active Navigation Row",
      "kind": "nav",
      "description": "Inverted equipment label used once per navigation surface.",
      "html": "<a class=\"ds-nav-active\" href=\"#\">Operations</a>",
      "css": ".ds-nav-active{display:flex;align-items:center;min-height:44px;padding:0 12px;border-radius:10px;background:oklch(var(--ink));color:oklch(var(--panel));font:600 14px 'IBM Plex Sans',sans-serif;text-decoration:none}.ds-nav-active:hover{background:oklch(var(--ink)/.92)}.ds-nav-active:focus-visible{outline:0;box-shadow:0 0 0 3px oklch(var(--focus)/.34)}"
    },
    {
